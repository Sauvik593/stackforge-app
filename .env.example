# ── Supabase (get from supabase.com → your project → Settings → API) ──
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Server-side only (NOT prefixed with VITE_ so Vite never exposes them) ──
# These go in Vercel's environment variable settings, NOT in .env in git

# Supabase service role key (Settings → API → service_role — KEEP SECRET)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic API key (platform.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Lemon Squeezy webhook secret (generated when you create a webhook)
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret

# Your Lemon Squeezy store slug and product variant ID
VITE_LS_STORE_SLUG=your-store-slug
VITE_LS_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/your-variant-id
