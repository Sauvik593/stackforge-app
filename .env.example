# ── Supabase (get from supabase.com → your project → Settings → API) ──────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Server-side only (NOT prefixed VITE_ — Vite never exposes these) ────────
# These go in Vercel's Environment Variables settings, NOT committed to git.

# Supabase service role key (Settings → API → service_role — KEEP SECRET)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic API key (platform.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Lemon Squeezy webhook signing secret (generated when you create a webhook)
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret

# Your Lemon Squeezy store slug and product checkout URL
VITE_LS_STORE_SLUG=your-store-slug
VITE_LS_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/your-variant-id

# CORS — set to your exact production URL (no trailing slash)
# If not set, falls back to VERCEL_URL (set automatically by Vercel)
# Example: https://stackforge-app.vercel.app or https://yourdomain.com
ALLOWED_ORIGIN=https://stackforge-app.vercel.app
